[importlinter]
root_packages =
    src
    ops
    scripts
include_external_packages = True

[importlinter:contract:broker-gateway]
name = Only gateway modules may import the broker SDK (alpaca)
type = forbidden
source_modules =
    src
    ops
    scripts
forbidden_modules =
    alpaca
allow_indirect_imports = true
# FIXED allow-list of gateway modules; adding a line is a reviewed decision.
ignore_imports =
    ops.rehearsal.broker_cassette_recording -> alpaca
    ops.rehearsal.conformance -> alpaca
    ops.rehearsal.conformance_sequence -> alpaca
    ops.rehearsal.primary_identity_assertion -> alpaca
    ops.rehearsal.secondary_preflight -> alpaca
    scripts.desk_reset -> alpaca
    scripts.export_alpaca_trades -> alpaca
    scripts.money_modules -> alpaca
    src.api.broker_reads -> alpaca
    src.execution.broker -> alpaca
    src.execution.broker_parts.account_reads -> alpaca
    src.execution.broker_parts.market_data -> alpaca
    src.execution.broker_parts.order_desk -> alpaca
    src.execution.broker_parts.order_desk_reads -> alpaca
    src.execution.broker_parts.stop_amend -> alpaca
    src.execution.broker_parts.stop_place -> alpaca
    src.execution.broker_parts.trade_stream -> alpaca
    src.execution.order_gates -> alpaca
    src.execution.stop_read -> alpaca

[importlinter:contract:trade-review-display-only]
name = Trade Review is display-only: agents and prompt facts may not import it
type = forbidden
source_modules =
    src.agents
    src.prompt_facts
forbidden_modules =
    src.storage.analytics.trade_review
allow_indirect_imports = true

[importlinter:contract:no-http-retry-on-broker-writes]
name = Broker write paths may not import urllib3 (no automatic HTTP retry on an order submission)
type = forbidden
source_modules =
    src.execution
    src.api.broker_reads
forbidden_modules =
    urllib3
allow_indirect_imports = true
