__pycache__/
*.py[cod]
*.egg-info/
*.egg
dist/
build/
.pytest_cache/
.venv/
/data/
.env
# Any hand-made copy of it too. A `.env.bak-<date>` sat untracked in the
# production checkout for thirteen days holding twelve live credentials,
# including broker keys — one careless `git add .` from being published.
# The blanket-stage rule that would have prevented that is a habit; this is
# the mechanical version.
.env.*
!.env.example
.DS_Store
*.log
*.log.*

# Left beside a board document when scripts/resolve_doc_conflict.py refuses a
# merge: it carries the plain-English reason and, where the resolver got that
# far, the merged text. Never board content — see that script for why the
# reason is deliberately NOT put inside the document.
*.merge-refusal

# Runtime log directory -- documented in the README layout block, never committed.
/logs/

# Raw secondary-account rehearsal capture is staged here before the public-
# safety gate approves an atomic move into a reviewed fixture path.
/ops/rehearsal/captures.local/

# Dashboard bundle: BUILD OUTPUT, never committed. frontend/ builds it at
# deploy (scripts/merge_and_deploy.sh) and in CI; see frontend/README.md.
/src/api/static_cockpit/
/src/api/.static_cockpit.*
