# Daily record-only universe screen — pairs with quant-agent-universe-daily.timer.
# Install:
#   cp scripts/systemd/quant-agent-universe-daily.* ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now quant-agent-universe-daily.timer
[Unit]
Description=quant-agent daily universe screen (record only, no LLM, no trading)

[Service]
Type=oneshot
WorkingDirectory=/home/qamc/quant-agent
EnvironmentFile=-/home/qamc/quant-agent/.env
# Records the screen result only; it places no orders. src.universe_daily
# skips itself when today's record already exists, so a re-fire is harmless.
# The screen asks the broker for its asset list, so it needs the real broker
# keys, delivered the same way as quant-agent-daily.service (never in .env).
LoadCredential=alpaca_api_key:/home/qamc/credentials/alpaca_api_key
LoadCredential=alpaca_secret_key:/home/qamc/credentials/alpaca_secret_key
# Owner Stop (ruling 2026-10-09): skipped cleanly, not failed, while the desk is Stopped.
ExecCondition=/home/qamc/quant-agent/scripts/owner_stop_gate.sh %n
ExecStart=/bin/bash -c 'ALPACA_API_KEY="$(<"$CREDENTIALS_DIRECTORY/alpaca_api_key")" ALPACA_SECRET_KEY="$(<"$CREDENTIALS_DIRECTORY/alpaca_secret_key")" exec /home/qamc/quant-agent/.venv/bin/python -m src.universe_daily'
# The program stops itself: the screen has its own deadline
# (screen_deadline_s, 900 s), then the Yahoo fund-category pass runs last and
# ends at the start of the desk's day (earnings_preprocess, 08:00 ET). Started
# at 03:00 ET that is 5 h = 18000 s; this systemd net adds one screen deadline
# (900 s) of margin above it.
TimeoutStartSec=18900
StandardOutput=journal
StandardError=journal
